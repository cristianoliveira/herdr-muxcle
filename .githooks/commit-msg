#!/bin/sh
message_file=$1
subject=$(sed -n '1p' "$message_file")
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'; then
  echo 'Invalid commit message. Use: type(scope): subject (e.g. feat(mod): add pane shortcut)' >&2
  exit 1
fi
